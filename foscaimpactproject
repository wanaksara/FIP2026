    <!-- SCRIPTS -->
    <script>
        // ==========================================
        // URL APPS SCRIPT (FINAL)
        // ==========================================
        const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxWVOg34o8fiHKyp7WPPZBP3N50rDs5RsRugvL00nGQvszsxHQsraR44mG-XVJmTuRz/exec";

        // Mobile Menu Logic
        const btn = document.getElementById('mobileMenuBtn');
        const menu = document.getElementById('mobileMenu');
        const icon = document.getElementById('menuIcon');
        
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            icon.className = menu.classList.contains('hidden') ? "fa-solid fa-bars text-xl" : "fa-solid fa-xmark text-xl";
        });
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
                icon.className = "fa-solid fa-bars text-xl";
            });
        });

        function scrollToForm() {
            document.getElementById('pendaftaran').scrollIntoView({ behavior: 'smooth' });
        }

        // Countdown Logic (Target: 13 Oct 2026)
        function startCountdown() {
            const target = new Date("October 13, 2026 23:59:59").getTime();
            setInterval(() => {
                const now = new Date().getTime();
                const dist = target - now;
                if (dist < 0) return;
                
                document.getElementById('cd-days').innerText = Math.floor(dist / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');
                document.getElementById('cd-hours').innerText = Math.floor((dist % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');
                document.getElementById('cd-mins').innerText = Math.floor((dist % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
                document.getElementById('cd-secs').innerText = Math.floor((dist % (1000 * 60)) / 1000).toString().padStart(2, '0');
            }, 1000);
        }
        startCountdown();

        // Topic Logic
        const topics = {
            1: { b: "Subtema A", t: "Waste & Circular Economy", d: "Penelitian dan inovasi terkait pengelolaan sampah, daur ulang, serta penerapan prinsip ekonomi sirkular." },
            2: { b: "Subtema B", t: "Pollution & Environmental Health", d: "Penelitian mengenai pencegahan serta penanganan pencemaran dan dampaknya terhadap kesehatan lingkungan." },
            3: { b: "Subtema C", t: "Climate & Energy", d: "Penelitian mengenai mitigasi dan adaptasi perubahan iklim serta inovasi energi terbarukan." },
            4: { b: "Subtema D", t: "Biodiversity & Conservation", d: "Penelitian mengenai perlindungan keanekaragaman hayati, konservasi ekosistem, dan pelestarian alam." },
            5: { b: "Subtema E", t: "Sustainable Society & Lifestyle", d: "Penelitian mengenai gaya hidup berkelanjutan, pemberdayaan masyarakat, dan solusi sosial untuk lingkungan." }
        };

        function selectTopic(num) {
            document.getElementById('topic-badge').innerText = topics[num].b;
            document.getElementById('topic-title').innerText = topics[num].t;
            document.getElementById('topic-desc').innerText = topics[num].d;
            
            for(let i=1; i<=5; i++){
                const btn = document.getElementById(`btn-topik-${i}`);
                if(i===num) btn.className = "topic-btn w-full text-left px-5 py-4 rounded-2xl font-bold text-sm border-2 transition-all bg-brand-dark text-white border-brand-dark shadow-md flex items-center justify-between";
                else btn.className = "topic-btn w-full text-left px-5 py-4 rounded-2xl font-bold text-sm border-2 transition-all bg-white text-slate-600 border-slate-200 hover:border-brand-teal flex items-center justify-between";
            }
        }

        // Form Logic
        function showAlert(msg) {
            const alert = document.getElementById('formAlert');
            document.getElementById('formAlertText').innerHTML = `<i class="fa-solid fa-circle-exclamation text-rose-500"></i> ${msg}`;
            alert.classList.remove('hidden');
            document.getElementById('formHeader').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        let currentStep = 1;
        function nextStep(step) {
            document.getElementById('formAlert').classList.add('hidden');

            if (step > 1 && currentStep === 1) {
                const req1 = ['email', 'nomorCP', 'asalSekolah', 'linkTwibbon', 'sumberInfo'];
                let isValid = true;
                req1.forEach(id => { if(!document.getElementById(id).value.trim()) isValid = false; });
                const r1 = document.querySelector('input[name="perwakilanKIR"]:checked');
                const r2 = document.querySelector('input[name="pilihanTim"]:checked');
                if (!isValid || !r1 || !r2) return showAlert('Mohon lengkapi semua data dan pilihan di Tahap 1.');
            }

            if (step > 2 && currentStep === 2) {
                const req2 = ['nama1', 'wa1', 'kelas1', 'nama2', 'wa2', 'kelas2'];
                let isValid = true;
                req2.forEach(id => { if(!document.getElementById(id).value.trim()) isValid = false; });
                if (!isValid) return showAlert('Mohon lengkapi data lengkap Ketua (Peserta 1) & Anggota (Peserta 2).');
            }

            for(let i=1; i<=3; i++) {
                document.getElementById(`step-${i}`).classList.add('hidden');
                const ind = document.getElementById(`step-ind-${i}`);
                const badge = document.getElementById(`step-badge-${i}`);
                if (i <= step) {
                    ind.classList.remove('opacity-50');
                    badge.classList.remove('bg-slate-800/50');
                    badge.classList.add('bg-white', 'text-brand-dark');
                } else {
                    ind.classList.add('opacity-50');
                    badge.classList.remove('bg-white', 'text-brand-dark');
                    badge.classList.add('bg-slate-800/50', 'text-white');
                }
            }
            
            document.getElementById(`step-${step}`).classList.remove('hidden');
            currentStep = step;
            document.getElementById('formHeader').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function getBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result.split(',')[1]);
                reader.onerror = error => reject(error);
                reader.readAsDataURL(file);
            });
        }

        async function submitForm(e) {
            e.preventDefault();
            document.getElementById('formAlert').classList.add('hidden');

            const fileInput = document.getElementById('fileBukti');
            if (!fileInput.files[0]) return showAlert('Unggah bukti pembayaran terlebih dahulu.');
            
            const file = fileInput.files[0];
            if (file.size > 5242880) return showAlert('Ukuran file maksimal 5MB agar tidak gagal saat dikirim via HP.');

            const btn = document.getElementById('btnSubmit');
            const icon = document.getElementById('submitIcon');
            const text = document.getElementById('submitText');

            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');
            icon.className = "fa-solid fa-spinner fa-spin";
            text.innerText = "MENGIRIM...";

            try {
                const base64Data = await getBase64(file);
                const data = {
                    email: document.getElementById('email').value.trim(),
                    asalSekolah: document.getElementById('asalSekolah').value.trim(),
                    nomorCP: document.getElementById('nomorCP').value.trim(),
                    sumberInfo: document.getElementById('sumberInfo').value,
                    linkTwibbon: document.getElementById('linkTwibbon').value.trim(),
                    perwakilanKIR: document.querySelector('input[name="perwakilanKIR"]:checked').value,
                    pilihanTim: document.querySelector('input[name="pilihanTim"]:checked').value,
                    
                    nama1: document.getElementById('nama1').value.trim(),
                    wa1: document.getElementById('wa1').value.trim(),
                    kelas1: document.getElementById('kelas1').value,
                    
                    nama2: document.getElementById('nama2').value.trim(),
                    wa2: document.getElementById('wa2').value.trim(),
                    kelas2: document.getElementById('kelas2').value,
                    
                    fileData: base64Data,
                    fileName: file.name,
                    mimeType: file.type
                };

                // Mode 'no-cors' + text/plain to entirely bypass browser CORS blocking
                await fetch(APPS_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify(data),
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
                });

                // Hide Form & Show Success Screen
                document.getElementById('formHeader').classList.add('hidden');
                document.getElementById('fipForm').classList.add('hidden');
                
                document.getElementById('resEmail').innerText = data.email;
                document.getElementById('resSekolah').innerText = data.asalSekolah;
                document.getElementById('resTim').innerText = `${data.pilihanTim} (${data.perwakilanKIR})`;
                document.getElementById('resKetua').innerText = data.nama1;

                document.getElementById('successScreen').classList.remove('hidden');
                document.getElementById('pendaftaran').scrollIntoView({ behavior: 'smooth', block: 'start' });

            } catch (err) {
                console.error(err);
                showAlert("Gagal terhubung ke server. Pastikan internet stabil dan coba lagi.");
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                icon.className = "fa-solid fa-paper-plane";
                text.innerText = "KIRIM PENDAFTARAN";
            }
        }
    </script>
